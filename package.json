{
	"name": "niagara_hockey_league",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"db-generate": "npx drizzle-kit generate --config=src/lib/drizzle/drizzle.config.ts",
		"db-migrate": "npx drizzle-kit migrate --config=src/lib/drizzle/drizzle.config.ts",
		"seed": "bun run src/lib/drizzle/seeds/seed.ts",
		"seed:teams": "bun run src/lib/drizzle/seeds/seed-teams.ts",
		"seed:seasons": "bun run src/lib/drizzle/seeds/seed-seasons.ts",
		"seed:players": "bun run src/lib/drizzle/seeds/seed-players.ts",
		"seed:rosters": "bun run src/lib/drizzle/seeds/seed-rosters.ts",
		"seed:games": "bun run src/lib/drizzle/seeds/seed-games.ts",
		"build": "vite build",
		"start": "node build/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@dnd-kit-svelte/svelte": "^0.1.6",
		"@dnd-kit/abstract": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-table": "^9.2.4",
		"@tanstack/table-core": "^8.21.3",
		"@types/jsonwebtoken": "^9.0.10",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"drizzle-kit": "^0.30.6",
		"embla-carousel-svelte": "^8.6.0",
		"layerchart": "^2.5.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^6.4.3"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@tabler/icons-svelte": "^3.46.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"moment": "^2.31.0",
		"postgres": "^3.4.9",
		"zod": "^4.6.5"
	}
}
